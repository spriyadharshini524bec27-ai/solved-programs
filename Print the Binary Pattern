import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		int n;
		Scanner in = new Scanner(System.in);
		System.out.print("Enter the n value: ");
		n=in.nextInt();
		for(int i=n;i>0;i--){
		    if(i%2==0){
		        for(int j=0;j<i;j++){
		            System.out.print("1");
		        }
		    }
		    else{
		        for(int k=0;k<i;k++){
		            System.out.print("0");
		        }
		    }
		    System.out.println("");
		    
	}
}
}
