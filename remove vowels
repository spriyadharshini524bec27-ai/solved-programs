import java.util.*;
public class Main
{
	public static void main(String[] args) {
	    System.out.println("Enter the string");
	    Scanner in=new Scanner(System.in);
	    String s=in.nextLine();
	    for(int i=0;i<s.length();i++){
	        char c=s.charAt(i);
	        if(c=='a'|| c=='e'||c=='i'||c=='o'||c=='u'||c=='A'||c=='E'||c=='I'||c=='O'||c=='U'){
	            continue;
	        }
	        else{
	            System.out.print(c);
	        }
	    }
}
}
