import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        System.out.println("Enter the product name, quantity, model:");
        
        String product = in.nextLine();
        int quantity = in.nextInt();
        in.nextLine();
        String model = in.nextLine();
        purchase(product);
        System.out.println(); 
        
        purchase(product, quantity);
        System.out.println();
        
        purchase(product, quantity, model);
        
    } 
    
    public static void purchase(String prod) {
        System.out.println("product: " + prod);
    }
    
    public static void purchase(String prod, int quan) {
        System.out.println("product: " + prod);
        System.out.println("quantity: " + quan);
    }
    
    public static void purchase(String prod, int quan, String mod) {
        System.out.println("product: " + prod);
        System.out.println("quantity: " + quan);
        System.out.println("model: " + mod);
    }
} 
